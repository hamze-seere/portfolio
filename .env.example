# Copy to .env.local for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.
# None of these are exposed to the browser except NEXT_PUBLIC_* values.

# Canonical public URL of the site (no trailing slash). Used for metadata, sitemap, OG images, security.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.dev

# --- Contact form (optional). Without these the form is disabled and visitors see the mailto link instead. ---
# Resend API key (https://resend.com) — server-only.
RESEND_API_KEY=
# Verified sender, e.g. "Portfolio <contact@your-domain.dev>"
CONTACT_FROM_EMAIL=
# Where messages are delivered (your inbox).
CONTACT_TO_EMAIL=

# Upstash Redis REST credentials (https://upstash.com) for distributed rate limiting — server-only.
# If unset, an in-memory limiter is used (fine for local dev, NOT reliable on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
